



<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sun Son Solar — Create Your Account</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --night: #10192B;
    --night-soft: #1B2740;
    --gold: #F2A93B;
    --gold-soft: #FBDDA0;
    --amber: #C97A2B;
    --cream: #FBF6EC;
    --teal: #1F8A70;
    --line: rgba(251, 246, 236, 0.14);
  }

  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: 'Work Sans', sans-serif;
    background: var(--night);
    color: var(--cream);
  }

  .screen {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
  }

  /* ---------- LEFT: brand / signature panel ---------- */
  .brand-panel {
    position: relative;
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background: linear-gradient(180deg, var(--night) 0%, var(--night-soft) 100%);
  }

  .brand-mark {
    font-family: 'Fraunces', serif;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.01em;
    z-index: 2;
  }
  .brand-mark span { color: var(--gold); }

  .brand-copy {
    z-index: 2;
    max-width: 420px;
  }

  .eyebrow {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
    margin-bottom: 18px;
  }

  .headline {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: clamp(32px, 3.6vw, 46px);
    line-height: 1.08;
    margin: 0 0 18px 0;
  }

  .headline em {
    font-style: normal;
    color: var(--gold);
  }

  .subcopy {
    font-size: 15px;
    line-height: 1.65;
    color: rgba(251, 246, 236, 0.72);
  }

  .stat-row {
    display: flex;
    gap: 40px;
    z-index: 2;
    margin-top: 40px;
  }
  .stat b {
    display: block;
    font-family: 'Fraunces', serif;
    font-size: 26px;
    color: var(--gold);
  }
  .stat span {
    font-size: 12px;
    color: rgba(251, 246, 236, 0.6);
    letter-spacing: 0.03em;
  }

  /* signature element: the sun's daily arc, rising as you scroll the form */
  .sun-arc-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .arc-path {
    stroke: rgba(242, 169, 59, 0.28);
    stroke-width: 1;
    fill: none;
    stroke-dasharray: 4 6;
  }
  .sun-dot {
    fill: var(--gold);
    filter: drop-shadow(0 0 18px rgba(242, 169, 59, 0.85));
  }
  .horizon {
    stroke: rgba(251, 246, 236, 0.12);
    stroke-width: 1;
  }

  /* ---------- RIGHT: form panel ---------- */
  .form-panel {
    background: var(--cream);
    color: var(--night);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 40px;
  }

  .form-card {
    width: 100%;
    max-width: 400px;
  }

  .form-title {
    font-family: 'Fraunces', serif;
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 6px 0;
  }

  .form-sub {
    font-size: 14px;
    color: rgba(16, 25, 43, 0.6);
    margin-bottom: 32px;
  }
  .form-sub a { color: var(--amber); text-decoration: none; font-weight: 500; }
  .form-sub a:hover { text-decoration: underline; }

  form { display: flex; flex-direction: column; gap: 18px; }

  .field { display: flex; flex-direction: column; gap: 7px; }

  .field label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgba(16, 25, 43, 0.55);
  }

  .field input,
  .field select {
    font-family: 'Work Sans', sans-serif;
    font-size: 15px;
    padding: 13px 14px;
    border-radius: 8px;
    border: 1.5px solid rgba(16, 25, 43, 0.15);
    background: #fff;
    color: var(--night);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field input::placeholder { color: rgba(16, 25, 43, 0.35); }

  .field input:focus,
  .field select:focus {
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(201, 122, 43, 0.15);
  }

  .row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .hint {
    font-size: 12px;
    color: rgba(16, 25, 43, 0.5);
    margin-top: -8px;
  }

  .terms {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: rgba(16, 25, 43, 0.65);
    line-height: 1.5;
    margin-top: 4px;
  }
  .terms input { margin-top: 3px; }
  .terms a { color: var(--amber); text-decoration: none; font-weight: 500; }

  .submit-btn {
    margin-top: 10px;
    padding: 14px 18px;
    border: none;
    border-radius: 8px;
    background: var(--night);
    color: var(--cream);
    font-family: 'Work Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .submit-btn:hover { background: var(--amber); }
  .submit-btn:active { transform: scale(0.99); }

  .divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 8px 0 4px 0;
    color: rgba(16, 25, 43, 0.4);
    font-size: 12px;
  }
  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: rgba(16, 25, 43, 0.12);
  }

  .footer-note {
    text-align: center;
    font-size: 13px;
    color: rgba(16, 25, 43, 0.55);
    margin-top: 22px;
  }
  .footer-note a { color: var(--night); font-weight: 600; text-decoration: none; }
  .footer-note a:hover { text-decoration: underline; }

  @media (max-width: 860px) {
    .screen { grid-template-columns: 1fr; }
    .brand-panel { padding: 40px 28px; min-height: 260px; }
    .stat-row { display: none; }
  }

  :focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
</style>
</head>
<body>

<div class="screen">

  <!-- LEFT: brand panel with signature sun-arc -->
  <section class="brand-panel">
    <div class="sun-arc-wrap" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 600 900" preserveAspectRatio="xMidYMid slice">
        <line class="horizon" x1="0" y1="620" x2="600" y2="620"></line>
        <path class="arc-path" d="M 40 620 A 260 260 0 0 1 560 620"></path>
        <circle class="sun-dot" cx="480" cy="440" r="7"></circle>
      </svg>
    </div>

    <div class="brand-mark">Sun<span>·</span>Son Solar</div>

    <div class="brand-copy">
      <div class="eyebrow">Homeowner Portal</div>
      <h1 class="headline">Every roof has<br><em>a sunrise waiting.</em></h1>
      <p class="subcopy">
        Create your account to schedule a site assessment, track your installation,
        and monitor how much sunlight you're putting to work — from first consult
        to first kilowatt.
      </p>
    </div>

    <div class="stat-row">
      <div class="stat"><b>1,240+</b><span>Roofs powered</span></div>
      <div class="stat"><b>18 min</b><span>Avg. quote time</span></div>
      <div class="stat"><b>25 yr</b><span>Panel warranty</span></div>
    </div>
  </section>

  <!-- RIGHT: registration form -->
  <section class="form-panel">
    <div class="form-card">
      <h2 class="form-title">Create your account</h2>
      <p class="form-sub">Already registered? <a href="login.html">Log in instead</a></p>

      <form id="registrationForm" novalidate>

        <div class="row-2">
          <div class="field">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" name="firstName" placeholder="Juan" required>
          </div>
          <div class="field">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" name="lastName" placeholder="Dela Cruz" required>
          </div>
        </div>

        <div class="field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" placeholder="you@email.com" required>
        </div>

        <div class="field">
          <label for="phone">Contact number</label>
          <input type="tel" id="phone" name="phone" placeholder="09XX XXX XXXX" required>
        </div>

        <div class="field">
          <label for="address">Property address</label>
          <input type="text" id="address" name="address" placeholder="Street, City, Province" required>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="At least 8 characters" minlength="8" required>
        </div>
        <p class="hint">Use 8+ characters with a mix of letters and numbers.</p>

        <div class="field">
          <label for="confirmPassword">Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter password" minlength="8" required>
        </div>

        <label class="terms">
          <input type="checkbox" id="terms" name="terms" required>
          <span>I agree to Sun Son Solar's <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</span>
        </label>

        <button type="submit" class="submit-btn">Create account</button>

        <div class="divider">or</div>

        <p class="footer-note">Need help with your account? <a href="#">Contact support</a></p>
      </form>
    </div>
  </section>

</div>

<script>
  document.getElementById('registrationForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const pw = document.getElementById('password').value;
    const confirm = document.getElementById('confirmPassword').value;

    if (pw !== confirm) {
      alert('Passwords do not match. Please check and try again.');
      return;
    }
    alert('Account created! (This is a static demo — connect this form to your backend to store data.)');
    this.reset();
  });
</script>

</body>
</html>




















